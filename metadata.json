{
  "name": "fee_module",
  "display_name": "EVM Fee Estimator",
  "version": "1.0.0",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "blockchain",
  "description": "EIP-1559 fee suggestion for EVM chains: slow/normal/fast tiers derived from eth_feeHistory, with custom overrides.",
  "main": "fee_module_plugin",
  "dependencies": ["eth_rpc_module"],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "FeeModule",
      "source": "src/glue.rs"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": []
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": []
    }
  }
}
